# Copiază în `.env.local`. În Vercel, aceleași nume, apoi redeploy.
# Copy to `.env.local`. On Vercel, set the same names, then redeploy.

# URL-ul public, fără slash la final. Folosit la success/cancel Stripe.
NEXT_PUBLIC_BASE_URL=https://www.mihaidaniel.ro

# Stripe — deja setate în producție. Nu le redenumi.
STRIPE_SECRET_KEY=sk_test_replace_me
STRIPE_WEBHOOK_SECRET=whsec_replace_me
# Opțional. Dacă lipsesc, checkout folosește prețul din cod: 200 EUR sesiunea 1:1, 250 EUR curs.
# STRIPE_PRICE_ID_CONSULTANCY se aplică doar sesiunii de 200 EUR.
# Pachetul de 3 sesiuni (540 EUR) și mentoratul (1.500 EUR) folosesc price_data din cod.
STRIPE_PRICE_ID_CONSULTANCY=
STRIPE_PRICE_ID_COURSE=

# Resend — email după plată, ghid, parteneriate, formularul de contact.
RESEND_API_KEY=re_replace_me

# Butoanele de contact de pe /consultanta-crypto apar doar dacă variabila e setată și validă.
# Gol sau invalid = butonul nu se afișează. Nu rămâne un link mort.
# WHATSAPP_NUMBER: cifre, cu prefix de țară. +, spații și liniuțe se scot.
# Exemplu: 40731490099 sau +40 731-490-099
WHATSAPP_NUMBER=

# CONTACT_EMAIL: o adresă validă. Exemplu: contact@stirilecrypto.ro
# După plată, dacă variabila lipsește, mesajul folosește contact@stirilecrypto.ro.
CONTACT_EMAIL=

# --- Verifică adresa (/verifica-adresa). Toate sunt opționale. Nu pune chei reale. ---
# Checkout-ul rămâne închis până când flag-ul, cheia Stripe, stocarea și MistTrack sunt toate setate.
# Cheile QuickExit sunt un cont Stripe separat. Nu le pune în STRIPE_SECRET_KEY.

# Secret pentru cron-ul zilnic. În producție, ruta de refresh răspunde 401 dacă lipsește.
CRON_SECRET=

# QuickExit, LLC — Stripe Checkout. Implicit dezactivat.
ADDRESS_CHECKER_PAYMENTS_ENABLED=
QUICKEXIT_STRIPE_SECRET_KEY=
QUICKEXIT_STRIPE_WEBHOOK_SECRET=

# USD pentru un raport. Dacă lipsește: 10.
RISK_REPORT_PRICE_USD=
# JSON opțional. Dacă lipsește, se folosesc pachetele din cod. [] le oprește.
# [{"id":"pack_5","credits":5,"priceUsd":40,"label":"Pachet 5 rapoarte"}]
RISK_REPORT_CREDIT_PACKS=

# Cât rămâne linkul raportului (ore, implicit 72) și al pachetului (zile, implicit 180).
REPORT_TTL_HOURS=
CREDIT_PASS_TTL_DAYS=

# Comenzi și rapoarte. Una dintre perechi este de ajuns (aceeași API REST).
# Aceeași pereche ține și clickurile de la /r/{slug}. Nu e nevoie de un store separat.
# Upstash Redis:
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
# sau Vercel KV:
KV_REST_API_URL=
KV_REST_API_TOKEN=

# Citirea statisticilor /api/r/stats. Fără ea, ruta răspunde 404.
# Generează una local: openssl rand -base64 32
AFF_STATS_KEY=

# Adaptor MistTrack. Obligatoriu ca să se poată încasa. Adresa pleacă la furnizor doar după plată.
RISK_REPORT_PROVIDER_ENABLED=
MISTTRACK_API_KEY=

# Origini suplimentare care pot încadra pagina și primi URL-ul de întoarcere Stripe.
# Implicit: mihaidaniel.ro și stirilecrypto.ro, cu și fără www.
# ADDRESS_CHECKER_EMBED_ORIGINS=https://preview.example

# Emailul cu linkul folosește RESEND_API_KEY, dacă există. Altfel linkul rămâne doar pe ecran.

# Slot sponsor / afiliat. Gol implicit. href trebuie să înceapă cu https://
VERIFICA_SPONSOR_ENABLED=
VERIFICA_SPONSOR_TITLE=
VERIFICA_SPONSOR_BODY=
VERIFICA_SPONSOR_HREF=
VERIFICA_SPONSOR_CTA=
VERIFICA_SPONSOR_DISCLOSURE=
