# Copiază în `.env.local`. În Vercel, aceleași nume, apoi redeploy.
# Copy to `.env.local`. On Vercel, set the same names, then redeploy.

# URL-ul public, fără slash la final. Folosit la success/cancel Stripe.
NEXT_PUBLIC_BASE_URL=https://www.mihaidaniel.ro

# Stripe — deja setate în producție. Nu le redenumi.
STRIPE_SECRET_KEY=sk_test_replace_me
STRIPE_WEBHOOK_SECRET=whsec_replace_me
# Opțional. Dacă lipsesc, checkout folosește prețul din cod: 200 EUR consultanță, 250 EUR curs.
STRIPE_PRICE_ID_CONSULTANCY=
STRIPE_PRICE_ID_COURSE=

# Resend — email după plată, ghid, parteneriate, formularul de contact.
RESEND_API_KEY=re_replace_me

# Programare după plată. Toate sunt opționale.
# Calendarul rămâne ascuns până pui un URL https (Cal.com, Calendly sau altul).
# Exemplu, când îl ai: https://cal.com/mihai/consultanta
BOOKING_URL=

# Doar cifre, cu prefix de țară, fără + și fără spații.
# Dacă lipsește, site-ul folosește 40731490099.
WHATSAPP_NUMBER=40731490099

# Dacă lipsește, site-ul folosește consultantacrypto.ro@gmail.com.
CONTACT_EMAIL=consultantacrypto.ro@gmail.com
