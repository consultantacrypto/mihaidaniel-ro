# Copiază în `.env.local`. În Vercel, aceleași nume, apoi redeploy.
# Copy to `.env.local`. On Vercel, set the same names, then redeploy.

# URL-ul public, fără slash la final. Folosit la success/cancel Stripe.
NEXT_PUBLIC_BASE_URL=https://www.mihaidaniel.ro

# Stripe — deja setate în producție. Nu le redenumi.
STRIPE_SECRET_KEY=sk_test_replace_me
STRIPE_WEBHOOK_SECRET=whsec_replace_me
# Opțional. Dacă lipsesc, checkout folosește prețul din cod: 200 EUR consultanță, 250 EUR curs.
STRIPE_PRICE_ID_CONSULTANCY=
STRIPE_PRICE_ID_COURSE=

# Resend — email după plată, ghid, parteneriate, formularul de contact.
RESEND_API_KEY=re_replace_me

# Programare după plată. Toate sunt opționale.
# Calendarul rămâne ascuns până pui un URL https (Cal.com, Calendly sau altul).
# Exemplu, când îl ai: https://cal.com/mihai/consultanta
BOOKING_URL=

# Doar cifre, cu prefix de țară, fără + și fără spații.
# Dacă lipsește, site-ul folosește 40731490099.
WHATSAPP_NUMBER=40731490099

# Dacă lipsește, site-ul folosește consultantacrypto.ro@gmail.com.
CONTACT_EMAIL=consultantacrypto.ro@gmail.com

# --- Verifică adresa (/verifica-adresa). Toate sunt opționale. Nu pune chei reale. ---
# Plata și adaptorul de risc rămân oprite până setezi flag-ul exact "true".
# Cheile QuickExit sunt un cont Stripe separat. Nu le pune în STRIPE_SECRET_KEY.

# Secret pentru cron-ul zilnic. În producție, ruta de refresh răspunde 401 dacă lipsește.
CRON_SECRET=

# QuickExit, LLC — Stripe Checkout pentru raportul complet. Implicit dezactivat.
ADDRESS_CHECKER_PAYMENTS_ENABLED=
QUICKEXIT_STRIPE_SECRET_KEY=
QUICKEXIT_STRIPE_WEBHOOK_SECRET=

# USD pentru un raport. Dacă lipsește: 10.
RISK_REPORT_PRICE_USD=
# JSON opțional. Dacă lipsește, se folosesc pachetele din cod. [] le oprește.
# [{"id":"pack_5","credits":5,"priceUsd":40,"label":"Pachet 5 rapoarte"}]
RISK_REPORT_CREDIT_PACKS=

# Adaptor MistTrack. Oprit până când ambele sunt setate. Nu chema din verificarea gratuită.
RISK_REPORT_PROVIDER_ENABLED=
MISTTRACK_API_KEY=

# Slot sponsor / afiliat. Gol implicit. href trebuie să înceapă cu https://
VERIFICA_SPONSOR_ENABLED=
VERIFICA_SPONSOR_TITLE=
VERIFICA_SPONSOR_BODY=
VERIFICA_SPONSOR_HREF=
VERIFICA_SPONSOR_CTA=
VERIFICA_SPONSOR_DISCLOSURE=
